---
import { Image } from 'astro:assets';
import Icon from '../../ui/icon/Icon.astro';
import { formatChf } from '../../../data/shop.js';

const { product, variant, qty = 1, image, index = 0 } = Astro.props;
---
<li class="cart-item" data-cart-item data-price={product.price} data-drawer-item style={`--i: ${index}`}>
  <div class="cart-item-inner">
    <a class="thumb" href="#" tabindex="-1" aria-hidden="true">
      <Image src={image} alt="" width={176} height={176} fit="cover" loading="lazy" />
    </a>
    <div class="info">
      <div class="info-top">
        <div>
          <p class="category">{product.category}</p>
          <a class="name" href="#">{product.name}</a>
        </div>
        <button class="remove" type="button" aria-label={`${product.name} entfernen`} data-cart-remove>
          <Icon name="close" size={16} />
        </button>
      </div>
      <p class="variant">{variant} · Art.-Nr. {product.sku}</p>
      <div class="info-bottom">
        <div class="qty">
          <button class="qty-btn" type="button" aria-label="Menge verringern" data-qty-step="-1" disabled={qty <= 1}>
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
          <input class="qty-input" type="text" inputmode="numeric" value={qty} aria-label="Menge" data-qty-input />
          <button class="qty-btn" type="button" aria-label="Menge erhöhen" data-qty-step="1">
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8M6 2v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          </button>
        </div>
        <div class="price-wrap">
          <span class="unit-price" data-unit-price>{qty > 1 ? `${formatChf(product.price)} / Stk.` : ''}</span>
          <span class="price" data-line-total>{formatChf(product.price * qty)}</span>
        </div>
      </div>
    </div>
  </div>
</li>
