---
import './tabs.css';

const { tabs, group, active = tabs[0].id, label, class: className } = Astro.props;
---
<div class:list={['c-tabs', className]} role="tablist" aria-label={label} data-tabs={group}>
  <div class="track">
    <span class="indicator" aria-hidden="true"></span>
    {tabs.map((tab) => (
      <button
        class:list={['tab', { 'is-active': tab.id === active }]}
        type="button"
        role="tab"
        id={`${group}-tab-${tab.id}`}
        aria-selected={tab.id === active ? 'true' : 'false'}
        aria-controls={`${group}-panel-${tab.id}`}
        tabindex={tab.id === active ? undefined : '-1'}
        data-tab={tab.id}
      >
        {tab.label}
      </button>
    ))}
  </div>
</div>
