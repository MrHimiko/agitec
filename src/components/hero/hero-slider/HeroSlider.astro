---
import { Image } from 'astro:assets';
import Button from '../../ui/button/Button.astro';
import BrandMark from '../../ui/brand-mark/BrandMark.astro';
import windowReveal from '../../../assets/images/hero-window-reveal.jpg';
import vipPanels from '../../../assets/images/hero-vip-panels.jpg';
import aerogelReveal from '../../../assets/images/hero-aerogel-reveal.jpg';
import wdvsBoard from '../../../assets/images/hero-wdvs-board.jpg';
import plasterMesh from '../../../assets/images/hero-plaster-mesh.jpg';
import { heroSlides } from '../../../data/home.js';
import '../../ui/glass/glass.css';
import './hero-slider.css';

const images = {
  'window-reveal': windowReveal,
  'vip-panels': vipPanels,
  'aerogel-reveal': aerogelReveal,
  'wdvs-board': wdvsBoard,
  'plaster-mesh': plasterMesh,
};
const { class: className } = Astro.props;
const isSlider = heroSlides.length > 1;
const pad = (n) => String(n).padStart(2, '0');

const slideStyle = (slide) => {
  const img = images[slide.image];
  return [
    `--ar: ${(img.width / img.height).toFixed(4)}`,
    `--fx: ${slide.focus[0]}`,
    `--fy: ${slide.focus[1]}`,
    `--ax-pct: ${slide.anchor.x[0]}`,
    `--ax-px: ${slide.anchor.x[1]}`,
    `--ay-pct: ${slide.anchor.y[0]}`,
    `--ay-px: ${slide.anchor.y[1]}`,
    `--min-w: ${slide.zoom ?? 100}`,
  ].join('; ');
};
---
<section
  class:list={['c-hero-slider', { 'is-slider': isSlider }, className]}
  aria-roledescription={isSlider ? 'Karussell' : undefined}
  aria-label="Highlights"
  data-hero
>
  <div class="slides">
    {heroSlides.map((slide, i) => {
      const img = images[slide.image];
      return (
        <div
          class:list={['slide', { 'is-active': i === 0 }]}
          id={`hero-slide-${slide.id}`}
          style={slideStyle(slide)}
          role={isSlider ? 'tabpanel' : undefined}
          aria-roledescription={isSlider ? 'Folie' : undefined}
          aria-label={isSlider ? `${i + 1} von ${heroSlides.length}: ${slide.tab}` : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-hero-slide
          data-anchor={JSON.stringify(slide.anchor)}
        >
          <div class="media" aria-hidden="true" data-anim-hero={i === 0 ? 'media' : undefined}>
            <Image
              src={img}
              alt=""
              widths={[768, 1200, img.width]}
              sizes="130vw"
              quality={90}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              data-hero-img
            />
            <span class="overlay"></span>
          </div>
          <div class="container content">
            <div class="head" data-hero-head>
              <p class="eyebrow" data-hero-part="eyebrow" data-anim-hero={i === 0 ? 'eyebrow' : undefined}>
                <BrandMark />
                <span>{slide.eyebrow}</span>
              </p>
              {i === 0 ? (
                <h1 class="title fs-57 fw-500 font-heading" data-hero-part="title" data-anim-hero="title">
                  {slide.title[0]}<br />{slide.title[1]}
                </h1>
              ) : (
                <p class="title fs-57 fw-500 font-heading" data-hero-part="title">
                  {slide.title[0]}<br />{slide.title[1]}
                </p>
              )}
            </div>
            <div class="foot" data-hero-foot>
              <p class="desc fs-17 text-muted" data-hero-part="desc" data-anim-hero={i === 0 ? 'desc' : undefined}>
                {slide.text}
              </p>
              <div class="buttons" data-hero-part="buttons" data-anim-hero={i === 0 ? 'buttons' : undefined}>
                <Button
                  href={slide.primary.href}
                  variant="primary"
                  icon="arrow-right"
                  tabindex={i === 0 ? undefined : '-1'}
                >
                  {slide.primary.label}
                </Button>
                <Button href={slide.secondary.href} variant="white" tabindex={i === 0 ? undefined : '-1'}>
                  {slide.secondary.label}
                </Button>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="decor" aria-hidden="true">
    <svg class="line" data-anim-hero="line" data-hero-line>
      <defs>
        <linearGradient id="hero-line-gradient" x1="0" y1="1" x2="1" y2="0" data-hero-gradient>
          <stop offset="0" stop-color="#C6C6C6" />
          <stop offset="1" stop-color="#4A9BD3" />
        </linearGradient>
      </defs>
      <path class="line-h" data-line-h />
      <path class="line-d" stroke="url(#hero-line-gradient)" data-line-d />
    </svg>
    <span class="hotspot" data-anim-hero="hotspot" data-hero-hotspot>
      <span class="hotspot-core"></span>
    </span>
  </div>

  {isSlider && (
    <div class="tabs-bar" data-anim-hero="tabs">
      <span class="c-glass tabs-glass" aria-hidden="true" data-glass='{"edges":"top","bezel":30,"thickness":110,"refraction":1.2,"blur":1.2,"saturate":1.4,"spec":0.6}'></span>
      <div class="container">
        <div class="tabs-shell">
          <span class="c-glass tabs-indicator" aria-hidden="true" data-glass='{"bezel":16,"thickness":70,"refraction":1.1,"blur":0.6,"saturate":1.5,"spec":0.6}' data-hero-indicator></span>
          <div class="tabs" role="tablist" aria-label="Themen">
            {heroSlides.map((slide, i) => (
              <button
                class:list={['tab', { 'is-active': i === 0 }]}
                type="button"
                role="tab"
                id={`hero-tab-${slide.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`hero-slide-${slide.id}`}
                tabindex={i === 0 ? undefined : '-1'}
                data-hero-tab={i}
              >
                <span class="num">{pad(i + 1)}</span>
                <span class="label">{slide.tab}</span>
                <span class="bar" aria-hidden="true"><span class="fill"></span></span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}
</section>

<script>
  import './hero-slider.js';
</script>
